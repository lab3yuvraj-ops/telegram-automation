# Backend settings. Telegram credentials belong in .env.telegram.
TEXT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
# Default Rachel voice. Replace this with any voice ID available in your
# ElevenLabs account when you want a different narrator.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# YouTube publishing stays disabled until a connected Zernio YouTube account is
# explicitly configured. Approval in Telegram never publishes while false.
ZERNIO_API_KEY=
ZERNIO_YOUTUBE_ACCOUNT_ID=
YOUTUBE_PUBLISH_ENABLED=false
YOUTUBE_VISIBILITY=public
# Image and video generation is fixed to Replicate Pruna. These settings are
# retained only as deployment documentation; the application does not select a
# media provider from environment variables.
IMAGE_PROVIDER=replicate_pruna
VIDEO_PROVIDER=replicate_pruna
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=google/nano-banana
REPLICATE_IMAGE_EDIT_MODEL=google/nano-banana
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=
REPLICATE_VIDEO_MODEL=prunaai/p-video-2
# Optional for the Telegram-only deployment. Configure a permanent Fernet key
# if you use encrypted per-user credentials or need to retain them after restarts.
APP_ENCRYPTION_KEY=
ALLOW_PAID_GENERATION=false
FFMPEG=ffmpeg
FFPROBE=ffprobe
BGM_FILE=
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
MAX_JOBS_PER_USER=3
# Railway: preserve existing DATABASE_URL and S3_* variables.
# Existing installations must keep the original APP_ENCRYPTION_KEY.
